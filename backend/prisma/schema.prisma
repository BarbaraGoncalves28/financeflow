generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  DIGITAL
  INVESTMENT
  WALLET
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum CreditCardStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

enum InstallmentStatus {
  PENDING
  PAID
  CANCELLED
}

enum CreditCardPurchaseStatus {
  COMPLETED
  CANCELLED
}

enum BudgetPeriod {
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringTransactionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum NotificationType {
  INSIGHT
  BUDGET
  GOAL
  INVOICE
  RECURRING
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
}

enum AssetType {
  STOCK         // Ações (ex: PETR4)
  CRYPTO        // Criptomoedas (ex: BTC, ETH)
  FII           // Fundos Imobiliários
  FIXED_INCOME  // Renda Fixa (CDB, Tesouro)
  ETF           // ETFs
  MUTUAL_FUND   // Fundos de Investimento
  OTHER
}

enum AssetTransactionType {
  BUY
  SELL
  DIVIDEND
  YIELD
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  refreshTokens       RefreshToken[]
  accounts            Account[]
  categories          Category[]
  transactions        Transaction[]
  transfers           Transfer[]
  creditCards         CreditCard[]
  creditCardPurchases CreditCardPurchase[]
  budgets             Budget[]
  financialGoals      FinancialGoal[]
  recurringTransactions RecurringTransaction[]
  notifications Notification[]
  auditLogs AuditLog[]
  settings    UserSettings?
  portfolios  Portfolio[]
}

model Session {
  id     String @id @default(cuid())
  userId String

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken?

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model RefreshToken {
  id        String @id @default(cuid())
  sessionId String @unique

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([expiresAt])
  @@index([revokedAt])
}

model Account {
  id     String @id @default(cuid())
  userId String

  name  String
  bank  String?
  type  AccountType
  color String?
  icon  String?

  initialBalance Decimal @db.Decimal(15, 2)
  currentBalance Decimal @db.Decimal(15, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions  Transaction[]
  transfersFrom Transfer[] @relation("TransferFromAccount")
  transfersTo   Transfer[]    @relation("TransferToAccount")

  invoicesPaid Invoice[] @relation("InvoicePaymentAccount")

  @@index([userId])
  @@index([userId, isActive])
}

model Category {
  id     String @id @default(cuid())
  userId String

  name  String
  type  CategoryType
  icon  String?
  color String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions        Transaction[]
  subcategories       Subcategory[]
  invoiceItems        InvoiceItem[]
  creditCardPurchases CreditCardPurchase[]
  budgetCategories    BudgetCategory[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Subcategory {
  id         String @id @default(cuid())
  categoryId String

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Transaction {
  id     String @id @default(cuid())
  userId String

  accountId     String
  categoryId    String
  subcategoryId String?

  type   TransactionType
  status TransactionStatus

  description String
  amount      Decimal @db.Decimal(15, 2)

  date  DateTime
  notes String?

  isRecurring Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  recurringExecution RecurringTransactionExecution?

  invoiceItems InvoiceItem[]

  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, accountId])
  @@index([userId, categoryId])
}

model Transfer {
  id     String @id @default(cuid())
  userId String

  fromAccountId String
  toAccountId   String

  amount Decimal @db.Decimal(15, 2)

  date        DateTime
  description String?
  notes       String?

  status TransactionStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromAccount Account @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)

  toAccount Account @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, fromAccountId])
  @@index([userId, toAccountId])
}

model CreditCard {
  id     String @id @default(cuid())
  userId String

  name String
  bank String?

  lastFourDigits String

  creditLimit    Decimal @db.Decimal(15, 2)
  availableLimit Decimal @db.Decimal(15, 2)

  closingDay Int
  dueDay     Int

  color String?
  icon  String?

  status CreditCardStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  invoices  Invoice[]
  purchases CreditCardPurchase[]

  @@index([userId])
  @@index([userId, status])
}

model Invoice {
  id String @id @default(cuid())

  creditCardId String

  referenceMonth Int
  referenceYear  Int

  closingDate DateTime
  dueDate     DateTime

  totalAmount Decimal @db.Decimal(15, 2)
  paidAmount  Decimal @db.Decimal(15, 2)

  status InvoiceStatus @default(OPEN)

  paidAt           DateTime?
  paymentAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  paymentAccount Account? @relation("InvoicePaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)

  items InvoiceItem[]

  @@unique([creditCardId, referenceMonth, referenceYear])
  @@index([creditCardId])
  @@index([creditCardId, status])
  @@index([dueDate])
}

model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String

  transactionId String?
  categoryId    String?

  description String

  purchaseDate DateTime

  amount Decimal @db.Decimal(15, 2)

  installmentNumber Int?
  totalInstallments Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  purchaseId String?

  purchase CreditCardPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  installments Installment[]

  @@index([invoiceId])
  @@index([transactionId])
  @@index([categoryId])
  @@index([purchaseDate])
}

model Installment {
  id String @id @default(cuid())

  invoiceItemId String

  installmentNumber Int
  totalInstallments Int

  amount Decimal @db.Decimal(15, 2)

  dueDate DateTime

  status InstallmentStatus @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceItem InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@unique([invoiceItemId, installmentNumber])
  @@index([invoiceItemId])
  @@index([dueDate])
  @@index([status])
}

model CreditCardPurchase {
  id String @id @default(cuid())

  userId       String
  creditCardId String
  categoryId   String?

  description  String
  purchaseDate DateTime

  totalAmount Decimal @db.Decimal(15, 2)

  installmentsCount Int @default(1)

  status CreditCardPurchaseStatus @default(COMPLETED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  invoiceItems InvoiceItem[]

  @@index([userId])
  @@index([userId, purchaseDate])
  @@index([creditCardId])
  @@index([categoryId])
}

model Budget {
  id String @id @default(cuid())

  userId String

  name String

  period BudgetPeriod

  startDate DateTime
  endDate   DateTime

  totalLimit Decimal @db.Decimal(15, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  categories BudgetCategory[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, startDate, endDate])
}

model BudgetCategory {
  id String @id @default(cuid())

  budgetId   String
  categoryId String

  limitAmount Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetId, categoryId])
  @@index([budgetId])
  @@index([categoryId])
}

model FinancialGoal {
  id     String @id @default(cuid())
  userId String

  name        String
  description String?

  targetAmount  Decimal @db.Decimal(15, 2)
  currentAmount Decimal @default(0) @db.Decimal(15, 2)

  targetDate DateTime?

  status GoalStatus @default(ACTIVE)

  color String?
  icon  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, targetDate])
}

model GoalContribution {
  id String @id @default(cuid())

  goalId String

  amount      Decimal  @db.Decimal(15, 2)
  date        DateTime
  description String?

  createdAt DateTime @default(now())

  goal FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([goalId, date])
}

model RecurringTransaction {
  id     String @id @default(cuid())
  userId String

  accountId     String
  categoryId    String
  subcategoryId String?

  type   TransactionType
  status RecurringTransactionStatus @default(ACTIVE)

  description String
  amount      Decimal @db.Decimal(15, 2)

  frequency RecurrenceFrequency

  startDate DateTime
  endDate   DateTime?

  nextRunDate DateTime

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  executions RecurringTransactionExecution[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, nextRunDate])
  @@index([userId, accountId])
  @@index([userId, categoryId])
}

model RecurringTransactionExecution {
  id String @id @default(cuid())

  recurringTransactionId String
  transactionId         String

  scheduledDate DateTime
  executedAt    DateTime @default(now())

  recurringTransaction RecurringTransaction @relation(fields: [recurringTransactionId], references: [id],onDelete: Cascade)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([recurringTransactionId, scheduledDate])
  @@unique([transactionId])
  @@index([recurringTransactionId])
  @@index([recurringTransactionId, scheduledDate])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType
  title String
  message String
  isRead Boolean @default(false)
  readAt DateTime?
  metadata Json?
  notificationKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationKey])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, type])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // Ex: TRANSACTION_CREATED, INVOICE_PAID, BUDGET_UPDATED
  entity    String   // Ex: Transaction, Invoice, Budget
  entityId  String?  // O ID do item que foi alterado/criado
  metadata  Json?    // Um JSON flexível para guardar dados antigos/novos (before/after)
  ipAddress String?  // Opcional: registrar de onde veio a requisição
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@map("audit_logs")
}

// ==========================================
// CONFIGURAÇÕES DO USUÁRIO
// ==========================================
model UserSettings {
  id        String @id @default(cuid())
  userId    String @unique

  currency  String @default("BRL")
  
  hideValues Boolean @default(false) // Modo privacidade ("olhinho" fechado)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// INVESTIMENTOS E PATRIMÔNIO
// ==========================================
model Portfolio {
  id          String  @id @default(cuid())
  userId      String
  name        String  // Ex: "Carteira Principal", "Aposentadoria"
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@index([userId])
}

model Asset {
  id          String    @id @default(cuid())
  portfolioId String

  ticker      String    // Código do ativo (Ex: VALE3, BTC)
  name        String    // Nome (Ex: Vale S.A., Bitcoin)
  type        AssetType

  // Usamos precisão (18, 8) porque criptomoedas exigem até 8 casas decimais
  quantity     Decimal @db.Decimal(18, 8) 
  averagePrice Decimal @db.Decimal(15, 4) // Preço médio de compra
  currentPrice Decimal @db.Decimal(15, 4) // Preço atual (para calcular rentabilidade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolio    Portfolio          @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  transactions AssetTransaction[]

  @@unique([portfolioId, ticker]) // Não deixa o usuário ter 2x o mesmo ticker na mesma carteira
  @@index([portfolioId])
}

model AssetTransaction {
  id      String @id @default(cuid())
  assetId String

  type        AssetTransactionType
  quantity    Decimal @db.Decimal(18, 8)
  price       Decimal @db.Decimal(15, 4)
  totalAmount Decimal @db.Decimal(15, 2) // Preço * Quantidade
  fees        Decimal @default(0) @db.Decimal(15, 2) // Taxas da corretora/B3/Gas

  date DateTime

  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([date])
}